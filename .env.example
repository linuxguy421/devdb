# PostgreSQL Configuration
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=devdb
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://postgres:postgres@postgres:5432/devdb

# Redis Caching Configuration
REDIS_URL=redis://redis:6379/0

# App & Security
SECRET_KEY=dev_secret_key_change_in_production_12345
ACCESS_TOKEN_EXPIRE_MINUTES=10080
DEBUG=True
ENVIRONMENT=development
COOKIE_SECURE=False

# Comma-separated usernames promoted to admin on next login
ADMIN_USERNAMES=

# Single username that is always admin and can never be demoted (e.g. SUPER_ADMIN=linuxguy421)
SUPER_ADMIN=

# Local avatar uploads (optional). Docker Compose sets AVATAR_DIR=/app/data/avatars
# AVATAR_DIR=data/avatars
# AVATAR_MAX_BYTES=2097152
# AVATAR_MAX_EDGE=512

# TMDB API Credentials
# Get a free key: https://www.themoviedb.org/settings/api
TMDB_API_KEY=[add your key here]
TMDB_BASE_URL=https://api.themoviedb.org/3
TMDB_IMAGE_BASE_URL=https://image.tmdb.org/t/p/w500
TMDB_READ_ACCESS_TOKEN=[add your token here]
